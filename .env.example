# Neon PostgreSQL connection string from Neon Console > Connect.
# The URL must begin with postgresql:// or postgres:// (not a /rest/v1 URL).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Discord OAuth application credentials (create an application in Discord Developer Portal).
AUTH_SECRET="generate-a-local-secret"
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
